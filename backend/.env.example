# KMS backend runtime environment.
NODE_ENV=development

# NestJS HTTP server port.
PORT=4005

# PostgreSQL connection string.
# Replace the password placeholder in your local .env file.
# Never commit a real Neon or production connection string.
DATABASE_URL=postgresql://forever:replace-with-local-password@localhost:5432/forever_hotel

# Local PostgreSQL uses false.
# Managed PostgreSQL environments that require TLS should use true.
DATABASE_SSL=false
# Central staff authorization; ROOT and kitchen roles only.
KMS_GATEWAY_AUTH_SESSION_URL=http://localhost:8080/kms/auth/session
# Match FOSS KMS_SERVICE_API_KEY; private random value, at least 32 characters.
KMS_ORDER_INTAKE_TOKEN=
KMS_RABBITMQ_URL=amqp://replace-user:replace-password@localhost:5672
KMS_ORDER_READY_ENABLED=true
KMS_REALTIME_ENABLED=true
