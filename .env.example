# Local Docker development only.
# Copy this file to .env and replace this placeholder.
# Never reuse this value for staging or production.
POSTGRES_PASSWORD=replace-with-local-dev-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=forever_owner
DB_PASSWORD=forever-local-only
DB_NAME=forever
DB_SSL=false
DB_SYNCHRONIZE=false
