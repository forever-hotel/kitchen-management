# Forever Hotel Kitchen Management System
# Next.js server-side API Gateway configuration.
#
# Local development: API Gateway running on the host at port 8080.
# Do not place passwords, access tokens or API keys in this file.

API_GATEWAY_URL=http://localhost:8080

PORT=3005
APP_ORIGIN=http://localhost:3005
SHARED_WEBSOCKET_URL=http://localhost:8081
KMS_SOCKET_PUBLIC_URL=http://localhost:8080
# Same private relay value as the shared service KMS registration.
KMS_WEBSOCKET_RELAY_KEY=
# Base64-encoded random 32-byte key. Keep stable across frontend restarts.
KMS_SESSION_ENCRYPTION_KEY=
# Local HTTP only; keep false for hosted HTTPS.
KMS_ALLOW_INSECURE_LOCAL_COOKIE=true
